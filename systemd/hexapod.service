[Unit]
Description=Hexapod Robot ROS 2 stack
# time-sync.target: the Pi 5 RTC is unbacked, so without this the stack starts on the
# restored shutdown time and the clock steps forward when NTP answers (DEC-21).
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__REPO_DIR__
Environment=HOME=__HOME__
# The ROS environment is set by launch.sh alone. autonomy:=true is passed here only: boot
# explores, and a manual launch.sh does not unless asked (robot.launch.py defaults to false).
ExecStart=__REPO_DIR__/scripts/launch.sh autonomy:=true
# ros2 launch shuts its nodes down cleanly on SIGINT (servos relax). KillMode=mixed sends it
# to ros2 launch alone; the default (control-group) also signals every node directly, so
# each got SIGINT twice (wk-robotics docs/common.md -> Robot startup is familial, rule 5).
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30
# Whatever happened above, leave servo power disabled (GPIO 4 high). The buzzer
# pin is owned by hexapod-buzzer-guard.service and is not touched here.
ExecStopPost=-/usr/bin/gpioset --mode=exit gpiochip4 4=1
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
