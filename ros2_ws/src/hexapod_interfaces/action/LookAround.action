# Look around with the head alone: full-width pan sweeps with the ultrasonic
# sensor level. The body does not move. Served by head_controller.

# Goal
uint8 sweeps             # Full pan sweeps, limit to limit and back (0 = 1)
float32 timeout_sec      # Maximum duration (0 = use default)
---
# Result
bool success             # True if every sweep completed
uint32 readings          # Ultrasonic ranges received during the survey
string message           # Human-readable result message
---
# Feedback
float32 pan_deg          # Current head pan, 0 = straight ahead, + = left
float32 progress         # 0.0 to 1.0
